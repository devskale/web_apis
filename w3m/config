# w3m/config

# Use colors in the output
color 1

# Display images if supported (set to 0 if you want to disable)
display_image 0

# Set the default language for web pages
accept_language de

# Cookies (set to 1 if you want to enable)
use_cookie 1
accept_cookie 1

display_link_number 1
display_link 0

# Set user agent string
user_agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"